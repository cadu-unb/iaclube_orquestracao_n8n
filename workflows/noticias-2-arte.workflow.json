    {
      "parameters": {
        "jsCode": "const pedidos = $('Montar pedidos de imagem').all();\nconst respostas = $input.all();\nconst tickets = respostas.map((r, i) => ({\n  ticket: r.json.ticket,\n  card: pedidos[i].json.card,\n  mascara: pedidos[i].json.mascara,\n  nome_arquivo: pedidos[i].json.nome_arquivo,\n}));\nreturn [{ json: { tickets, total: tickets.length, iniciado_em: Date.now() } }];"
      },
      "id": "ad71ed9b-5656-5c3e-b5de-19073b527285",
      "name": "Reunir tickets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
