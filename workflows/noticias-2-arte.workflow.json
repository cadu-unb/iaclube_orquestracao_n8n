      "webhookId": "985f44c3-5b5b-5717-8ae5-35bf72e43be3"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Configuração').first().json.url_ponte }}/gerador/api/v1/status?tickets={{ $('Reunir tickets').first().json.tickets.map(t => t.ticket).join(',') }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Ponte-Token",
              "value": "={{ $('Configuração').first().json.token_ponte }}"
            }
          ]
        },
