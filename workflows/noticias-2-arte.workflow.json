    {
      "parameters": {
        "jsCode": "const v = $('Validar entrada').first().json;\nconst { largura, altura } = v.cfg;\n// O estilo vem do documento lido pela ponte (nó Ler estilo) ou, em arquivo antigo, do estilo_comum escrito na entrada.\nconst estilo = v.estilo_documento ? String($('Ler estilo').first().json.corpo || '').trim() : v.estilo_comum;\nif (v.estilo_documento && !estilo) throw new Error('O documento de estilo «' + v.estilo_documento + '» está vazio.');\nreturn v.imagens.map((im, i) => {\n  const nome = im.nome_arquivo || 'noticia-' + String(i + 1).padStart(2, '0');\n  const prompt = estilo ? im.prompt.trim() + ', ' + estilo : im.prompt.trim();\n  return { json: {\n    indice: i,\n    card: im.card,\n    mascara: im.mascara,\n    nome_arquivo: nome,\n    corpo: { prompt, width: largura, height: altura, nome_arquivo: nome },\n  } };\n});"
      },
