      },
      "id": "a8f5cd3c-8ca9-5a5d-8bd3-4f8f69ee3a73",
      "name": "Consultar andamento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        400
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const r = $('Reunir tickets').first().json;\nconst cfg = $('Validar entrada').first().json.cfg;\nconst jobs = $input.first().json.jobs || {};\nconst cont = { queued: 0, running: 0, completed: 0, failed: 0, outro: 0 };\nconst falhas = [];\nfor (const t of r.tickets) {\n  const j = jobs[t.ticket] || { status: 'not_found' };\n  if (j.status in cont) cont[j.status]++; else cont.outro++;\n  if (j.status === 'failed' || j.status === 'not_found') {\n    falhas.push('card ' + t.card + ' (' + t.nome_arquivo + '): ' + (j.error || j.status));\n  }\n}\nconst minutos = Math.round((Date.now() - r.iniciado_em) / 6000) / 10;\nlet estado = 'esperando';\nlet motivo = '';\nif (falhas.length) {\n  estado = 'falhou';\n  motivo = 'Falha ao gerar imagem: ' + falhas.join(' | ');\n} else if (cont.completed === r.total) {\n  estado = 'concluido';\n} else if (minutos > cfg.tempo_maximo_geracao_min) {\n  estado = 'tempo_esgotado';\n  motivo = 'As imagens passaram de ' + cfg.tempo_maximo_geracao_min + ' min e ainda faltam ' + (r.total - cont.completed) + '.';\n}\nreturn [{ json: { estado, motivo, minutos, total: r.total, ...cont } }];"
      },
