    {
      "parameters": {
        "jsCode": "const v = $('Validar entrada').first().json;\nconst tickets = $('Listar tickets').all();\nconst resultados = $input.all();\nconst imagens = [];\nconst problemas = [];\nresultados.forEach((r, i) => {\n  const t = tickets[i].json;\n  const caminho = r.json.output_path;\n  if (!r.json.ready || !caminho) {\n    problemas.push('card ' + t.card + ' (' + t.nome_arquivo + '): imagem sem caminho de arquivo');\n  } else {\n    imagens.push({ card: t.card, mascara: t.mascara, caminho });\n  }\n});\nif (problemas.length) return [{ json: { ok: false, motivo: problemas.join(' | ') } }];\nreturn [{ json: { ok: true, pedido: {\n  versao: 1,\n  nome: v.nome,\n  tipo: v.tipo,\n  entrada: v.entrada,\n  imagens,\n  // instrucoes: true grava, ao lado dos PNG, o <base>_instrucoes.json: o arquivo que a tela do\n  // gerenciador reabre (\"Abrir a partir de instruções\") para corrigir qualquer detalhe de formatação.\n  exportacao: { formatos: ['png'], escalas: [1], instrucoes: true },\n} } }];"
      },
