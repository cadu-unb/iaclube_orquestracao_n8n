    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nlet msg;\nif (j.motivo) {\n  msg = j.motivo;\n} else if (j.ready === false) {\n  msg = 'O gerador subiu, mas não está pronto: ' + (j.problems || []).join(' | ');\n} else if (j.error) {\n  const e = j.error;\n  msg = (e.message || JSON.stringify(e)) + (e.description ? ' — ' + e.description : '');\n} else if (j.stdout) {\n  msg = j.stdout;\n} else {\n  msg = 'Falha sem detalhe: ' + JSON.stringify(j).slice(0, 500);\n}\nreturn [{ json: { mensagem: msg } }];"
      },
