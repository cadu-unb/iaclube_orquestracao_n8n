      "id": "6aceb727-d81e-518f-9955-9c1c23c80419",
      "name": "Ver situação dos servidores",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        -120
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Configuração').first().json;\nconst r = $input.first().json;\nconst nomes = { gerador: 'Gerador de imagens', gerenciador: 'Gerenciador de carrosséis' };\nconst portas = { gerador: cfg.porta_gerador, gerenciador: cfg.porta_gerenciador };\n\nif (r.erros || !Array.isArray(r.servidores)) {\n  const motivo = (r.erros && r.erros[0] && r.erros[0].mensagem) || 'resposta inesperada da ponte';\n  return [{ json: { estado: 'erro', titulo: 'Não consegui verificar os servidores',\n    detalhes: ['A ponte recusou o pedido: ' + motivo + '. Confira o token no nó Configuração.'] } }];\n}\n\nconst ocupados = [];\nfor (const s of r.servidores) {\n  const quem = nomes[s.servidor] + ' (porta ' + portas[s.servidor] + ')';\n  if (s.rodando) {\n    ocupados.push(quem + ': já está ligado e em uso. Pode ser outra pessoa, ou um fluxo em andamento (como a geração de notícias).');\n  } else if (s.porta_ocupada) {\n    ocupados.push(quem + ': a porta está ocupada por outro programa do computador.');\n  }\n}\nif (ocupados.length) {\n  return [{ json: { estado: 'ocupado', titulo: 'Servidor ocupado: nada foi ligado nem desligado', detalhes: ocupados } }];\n}\nreturn [{ json: { estado: 'livre' } }];"
      },
