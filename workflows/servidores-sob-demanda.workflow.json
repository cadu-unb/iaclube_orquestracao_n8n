          "appendAttribution": false
        }
      },
      "id": "fe0cffc1-8501-58b0-b5a7-fb2f8226ee3a",
      "name": "Formulário: desligar",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        1000
      ],
      "webhookId": "cf045b88-7e51-5559-960c-1c21329e95b6"
    },
    {
      "parameters": {
        "jsCode": "// Edite aqui. É o único lugar com endereço da ponte, token, portas e limites.\nconst entrada = $input.first().json;\nconst desligar = Object.prototype.hasOwnProperty.call(entrada, 'Desligar agora');\n\n// Tempo ligado, em minutos: o que a pessoa digitou, de 5 a 240. Vazio = 60.\nlet minutos = Number(entrada['Minutos ligados']);\nif (!Number.isFinite(minutos) || minutos <= 0) minutos = 60;\nminutos = Math.min(Math.max(Math.round(minutos), 5), 240);\n\nreturn [{ json: {\n  acao: desligar ? 'desligar' : 'ligar',\n  minutos,\n  // A ponte roda no computador, como o usuário cadu (scripts/ponte.py). De dentro do container\n  // runv2-n8n-1 o computador é o gateway da rede runv2_default: 172.19.0.1.\n  url_ponte: 'http://172.19.0.1:7777',\n  token_ponte: 'COLE_AQUI_O_TOKEN_QUE_A_PONTE_MOSTRA',\n  porta_gerador: 7000,\n  porta_gerenciador: 8000,\n} }];"
      },
      "id": "902e8383-f70f-5a9e-8832-6d7b4e424f32",
      "name": "Configuração",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "ed561939-ac37-5f57-ab95-e5c046e65a23",
              "leftValue": "={{ $json.acao === 'ligar' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "55cea5cc-1cf2-563b-b97a-afd7d78555e1",
      "name": "Ligar?",
