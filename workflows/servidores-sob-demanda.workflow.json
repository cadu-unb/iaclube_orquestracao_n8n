      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const g = $('Conferir saúde do gerador').first().json;\nif (g.ready !== true) {\n  throw new Error('O gerador ligou, mas não está pronto: ' + ((g.problems || []).join(' | ') || 'sem detalhe'));\n}\nreturn [{ json: { ok: true } }];"
      },
      "id": "d97d2d7b-c720-57b7-852b-ce289681e563",
      "name": "Avaliar prontidão",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2660,
        -220
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Configuração').first().json;\nconst fim = new Date(Date.now() + cfg.minutos * 60000);\nconst hora = fim.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', timeZone: 'America/Sao_Paulo' });\nconst linhas = [\n  'Servidores ligados por ' + cfg.minutos + ' minutos (desligam sozinhos às ' + hora + ').',\n  '',\n  'Gerador de imagens: http://127.0.0.1:' + cfg.porta_gerador,\n  'Gerenciador de carrosséis: http://127.0.0.1:' + cfg.porta_gerenciador,\n  '',\n  'Abra os endereços neste computador. Para desligar antes, use o formulário Desligar.',\n];\nreturn [{ json: { mensagem: linhas.join('\\n'), desliga_as: hora } }];"
      },
