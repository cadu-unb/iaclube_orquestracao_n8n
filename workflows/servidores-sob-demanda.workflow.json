        0
      ],
      "webhookId": "96bcb848-888a-55a8-9ec4-ad39ec50630b"
    },
    {
      "parameters": {
        "formTitle": "Desligar os servidores do IA Clube",
        "formDescription": "Desliga os servidores que este fluxo ligou. Use quando terminar antes do tempo.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Desligar agora",
              "fieldType": "checkbox",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Sim, desligar os dois servidores"
                  }
                ]
              },
              "requiredField": true
            }
          ]
        },
        "responseMode": "responseNode",
        "options": {
