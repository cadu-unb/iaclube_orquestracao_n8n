      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Os dois já foram mandados ligar, um logo depois do outro: eles iniciam ao mesmo tempo.\nconst g = $('Subir gerador').first().json;\nconst m = $input.first().json;\nconst problemas = [];\nif (g.ok !== true) problemas.push('gerador: ' + ((g.mensagem) || (g.erros && g.erros[0] && g.erros[0].mensagem) || 'a ponte não conseguiu ligar'));\nif (m.ok !== true) problemas.push('gerenciador: ' + ((m.mensagem) || (m.erros && m.erros[0] && m.erros[0].mensagem) || 'a ponte não conseguiu ligar'));\nif (problemas.length) throw new Error('Não consegui ligar: ' + problemas.join(' | '));\nreturn [{ json: { ok: true } }];"
      },
