    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst desligou = r.ok === true;\nreturn [{ json: { ok: desligou, mensagem: desligou ? 'Tempo esgotado: servidores desligados.' : 'Tempo esgotado, mas não consegui confirmar o desligamento. Confira as portas 7000 e 8000.', resposta_da_ponte: r } }];"
      },
      "id": "e39df751-0992-50ae-898f-0fb98180586a",
      "name": "Resumo final",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
