        3860,
        -220
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nlet motivo;\nconst e = j.error;\nif (typeof e === 'string') motivo = e;\nelse if (e && (e.message || e.description)) motivo = (e.message || '') + (e.description ? ' — ' + e.description : '');\nelse if (j.mensagem) motivo = j.mensagem;\nelse motivo = 'falha sem detalhe: ' + JSON.stringify(j).slice(0, 400);\nreturn [{ json: { motivo } }];"
      },
